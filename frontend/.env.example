VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Show a "Demo accounts" panel on the sign-in pages that fills in the logins created by
# `python manage.py load_demo`. Local demos only; keep it false for any real deployment.
VITE_SHOW_DEMO_LOGINS=false
