# Local development defaults. In production, use DEBUG=False and a unique generated secret.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Production database settings (enable by setting DATABASE_ENGINE=django.db.backends.postgresql)
DATABASE_ENGINE=django.db.backends.sqlite3
POSTGRES_DB=insurex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# When TLS terminates at a reverse proxy, configure it to overwrite X-Forwarded-Proto and set true.
USE_X_FORWARDED_PROTO=False
