# Copy to .env (or set these in your hosting dashboard). Never commit real secrets.

# --- Core -----------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-api-host.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
FRONTEND_URL=https://your-frontend.example.com

# --- Database -------------------------------------------------------------
# PostgreSQL in production. SSL is required automatically when DEBUG=False.
# Leave unset to use local SQLite for development.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Uploads (object storage) ---------------------------------------------
# Set to true in hosted environments so files survive restarts and redeploys.
USE_S3_STORAGE=false
AWS_STORAGE_BUCKET_NAME=insurex-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 or Supabase Storage, set the S3-compatible endpoint:
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# --- Background jobs (Celery) ------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Premium rating --------------------------------------------------------
# The premium tables live in POLICY_RATING_TABLES in config/settings.py.
# They are indicative demonstration values until approved insurer rates replace them.

# --- Claim routing (RL advisory) ---------------------------------------------
CLAIM_ROUTING_MODEL_PATH=
CLAIM_ROUTING_ENFORCE_EVALUATION_GATE=false
